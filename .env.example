# ─────────────────────────────────────────────────────────────────────────────
# ThingsPanel 1.2-release 部署环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env
# 部署脚本 deploy-aliyun.yml 会在首次安装时自动生成缺失的 .env
# ─────────────────────────────────────────────────────────────────────────────

# 镜像仓库（部署机器与 ACR 同区域，使用 VPC 内网地址拉取更快）
TP_ACR_REGISTRY=crpi-8l7h3z38ikkatd81-vpc.cn-shanghai.personal.cr.aliyuncs.com/peak-aiot

# 各组件镜像 tag（与各仓库 1.2-release 分支构建产物一致）
TP_TAG_FRONTEND=v1.2.12.1
TP_TAG_BACKEND=v1.2.12.1
TP_TAG_GMQTT=v1.1.7
TP_TAG_TIMESCALEDB=14
TP_TAG_REDIS=6.2.7
TP_TAG_MODBUS=v1.0.6.1
TP_TAG_HTTP_ADAPTER=v1.1.0
TP_TAG_THINGSVIS=v1.0.23

# 数据库 / Redis 凭据
TP_DATABASE_PASSWORD=postgresThingsPanel
TP_REDIS_PASSWORD=redis

# thingsvis-server 会话签名密钥（留空时由部署脚本首次安装自动生成随机值）
TP_THINGSVIS_AUTH_SECRET=

# 宿主机端口（默认已与 v1.3.0 dev 栈错开，避免同机冲突；可按需覆盖）
TP_HTTP_PORT=18080
TP_POSTGRES_PORT=15555
TP_REDIS_PORT=16379
TP_MQTT_PORT=11883
TP_GMQTT_WS_PORT=18082
TP_GMQTT_API_PORT=18083
TP_BACKEND_PORT=19999
TP_MODBUS_PORT=1502
TP_MODBUS_HTTP_PORT=1503
TP_HTTP_ADAPTER_PORT=29090
TP_HTTP_ADAPTER_HTTP_PORT=29091
TP_THINGSVIS_SERVER_PORT=18000
TP_THINGSVIS_STUDIO_PORT=13000
